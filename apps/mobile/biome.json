{
  "root": false,
  "extends": "//",
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "src/**",
      "*.ts",
      "*.tsx",
      "*.js",
      "!.expo",
      "!android",
      "!ios",
      "!expo-env.d.ts",
      "!assets/expo.icon"
    ]
  },
  "linter": {
    "rules": {
      "complexity": {
        "useArrowFunction": "off",
        "noExcessiveCognitiveComplexity": "warn"
      },
      "suspicious": {
        "noArrayIndexKey": "off"
      },
      "style": {
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "paths": {
              "react-native": {
                "importNames": ["Alert"],
                "message": "Use the themed alert in @/utils/alert."
              }
            },
            "patterns": [
              {
                "group": ["../*", "../../*", "../../../*"],
                "message": "Import through the @/ alias instead of climbing directories."
              }
            ]
          }
        }
      }
    }
  },
  "overrides": [
    {
      "includes": ["src/utils/alert.ts", "**/*.test.ts", "**/*.test.tsx"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": "off"
          }
        }
      }
    }
  ],
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
