EXPO_PUBLIC_APP_NAME=Stryde
EXPO_PUBLIC_APP_ENV=development

EXPO_PUBLIC_PRIVY_APP_ID=your_privy_app_id
EXPO_PUBLIC_PRIVY_CLIENT_ID=your_privy_client_id

EXPO_PUBLIC_CHAIN_MODE=ethereum-sepolia
EXPO_PUBLIC_RPC_URL=https://rpc.ankr.com/eth_sepolia
EXPO_PUBLIC_CHAIN_ID=11155111
EXPO_PUBLIC_SUBGRAPH_URL=
EXPO_PUBLIC_API_URL=http://localhost:3000
# Must match API_KEY in packages/api/.env
EXPO_PUBLIC_API_KEY=
EXPO_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# World ID Selfie Check
EXPO_PUBLIC_WORLD_APP_ID=
EXPO_PUBLIC_WORLD_RP_ID=
EXPO_PUBLIC_WORLD_ENVIRONMENT=production

# Gasless smart-account writes via Privy Smart Wallets, sponsored by a
# paymaster policy enabled in the Privy Dashboard. Only applies in remote
# (sepolia) chain modes. On by default; set to 'false' to opt out and use
# the raw embedded wallet (requires the wallet to hold its own gas).
EXPO_PUBLIC_USE_SMART_WALLET=true

# Facebook/Meta App ID required by react-native-share to attribute Instagram
# Stories shares. Without it, shareToInstagramStories no-ops with an alert.
EXPO_PUBLIC_FACEBOOK_APP_ID=
