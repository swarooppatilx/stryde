{
  "expo": {
    "name": "Stryde",
    "slug": "stryde-expo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": ["stryde", "strydeexpo"],
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.stryde.app",
      "infoPlist": {
        "LSApplicationQueriesSchemes": ["instagram-stories", "instagram"]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png"
      },
      "package": "com.stryde.app",
      "permissions": [
        "android.permission.ACTIVITY_RECOGNITION",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.health.READ_EXERCISE",
        "android.permission.health.READ_DISTANCE",
        "android.permission.health.READ_EXERCISE_ROUTES",
        "android.permission.health.READ_HEART_RATE",
        "android.permission.health.READ_TOTAL_CALORIES_BURNED",
        "android.permission.health.READ_WEIGHT",
        "android.permission.health.READ_HEIGHT",
        "android.permission.health.READ_RESTING_HEART_RATE"
      ],
      "predictiveBackGestureEnabled": false,
      "queries": [
        { "package": "org.world.id.sandbox" },
        { "package": "com.worldcoin" },
        {
          "intent": {
            "action": "VIEW",
            "data": {
              "scheme": "https",
              "host": "sandbox.world.org"
            }
          }
        },
        {
          "intent": {
            "action": "VIEW",
            "data": {
              "scheme": "worldappsandbox"
            }
          }
        },
        {
          "intent": {
            "action": "VIEW",
            "data": {
              "scheme": "worldidsandbox"
            }
          }
        }
      ]
    },
    "plugins": [
      "./plugins/withSceneLifecycle.cjs",
      "expo-router",
      "react-native-health-connect",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FC5200",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 140
        }
      ],
      "@rnmapbox/maps",
      "expo-secure-store",
      "expo-web-browser",
      "@react-native-community/datetimepicker",
      "expo-status-bar",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/android-icon-foreground.png",
          "color": "#FC5200"
        }
      ],
      "expo-system-ui",
      [
        "expo-font",
        {
          "fonts": [
            "../../node_modules/@expo-google-fonts/inter/400Regular/Inter_400Regular.ttf",
            "../../node_modules/@expo-google-fonts/inter/600SemiBold/Inter_600SemiBold.ttf",
            "../../node_modules/@expo-google-fonts/inter/700Bold/Inter_700Bold.ttf",
            "../../node_modules/@expo-google-fonts/inter/800ExtraBold/Inter_800ExtraBold.ttf"
          ]
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26,
            "buildArchs": ["arm64-v8a"],
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "enableBundleCompression": true,
            "useLegacyPackaging": true
          }
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Stryde to record your routes and claim territory.",
          "locationAlwaysAndWhenInUsePermission": "Allow Stryde to keep recording your route in the background.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-sensors",
        {
          "motionPermission": "Allow Stryde to count your steps while tracking activities."
        }
      ],
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "Stryde reads heart rate and steps from your Apple Watch to prove real effort on segments.",
          "NSHealthUpdateUsageDescription": false,
          "background": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "e30a139d-042c-4d5f-b088-ebfa80d0fda2"
      }
    },
    "owner": "piyush690"
  }
}
