{
  "name": "stryde",
  "private": true,
  "packageManager": "yarn@4.18.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "biome format --write .",
    "check": "biome check .",
    "check-types": "turbo run check-types",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "lefthook": "^2.1.12",
    "turbo": "^2.10.12",
    "typescript": "7.0.2",
    "vite": "^6.0.0"
  },
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
