{
  "name": "stryde",
  "private": true,
  "packageManager": "yarn@4.18.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "biome format --write .",
    "check": "biome check .",
    "check-types": "turbo run check-types",
    "prepare": "lefthook install",
    "dev:local": "bash packages/contracts/scripts/dev-local.sh"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "lefthook": "^2.2.2",
    "turbo": "^2.11.10",
    "typescript": "catalog:",
    "vite": "^6.0.0"
  },
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependenciesMeta": {
    "@shopify/react-native-skia": {
      "built": true
    }
  }
}
