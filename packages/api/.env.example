# API Configuration
# Ethereum Sepolia
CHAIN_ID=11155111
RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# IPFS Pinning (Pinata)
PINATA_API_KEY=
PINATA_SECRET_KEY=
PINATA_JWT=

# Push Notifications (Expo)
EXPO_ACCESS_TOKEN=

# The Graph
SUBGRAPH_URL=https://api.studio.thegraph.com/query/stryde/stryde-base-sepolia/version/latest

# Frontend
# Comma-separated list of allowed origins for CORS.
CORS_ORIGIN=http://localhost:3000,https://stryde-web.vercel.app

# Shared-secret gate for write endpoints (e.g. /api/ipfs/*). Must match
# EXPO_PUBLIC_API_KEY in apps/mobile/.env. Leave unset to disable in local dev.
API_KEY=

# World ID Selfie Check
WORLD_RP_SIGNING_KEY=
WORLD_APP_ID=
WORLD_RP_ID=
WORLD_ENVIRONMENT=sandbox
WORLD_SKIP_REMOTE_VERIFY=false
WORLD_DEVELOPER_API_KEY=
