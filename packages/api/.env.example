# API Configuration
# NOTE: `yarn dev` reads .env (+ optional .env.local overrides), `yarn dev:prod`
# reads .env.prod, `yarn dev:production` reads .env.production. The code reads
# RELAYER_CHAIN_ID / RELAYER_RPC_URL / RELAYER_PRIVATE_KEY for onchain writes —
# keep CHAIN_ID/RPC_URL as aliases for tooling but set both.
# Ethereum Sepolia
RELAYER_CHAIN_ID=11155111
RELAYER_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
CHAIN_ID=11155111
RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# IPFS Pinning (Pinata)
PINATA_API_KEY=
PINATA_SECRET_KEY=

# Push Notifications (Expo)
EXPO_ACCESS_TOKEN=

# The Graph
SUBGRAPH_URL=https://api.studio.thegraph.com/query/stryde/stryde-base-sepolia/version/latest

# Frontend
# Comma-separated list of allowed origins for CORS.
CORS_ORIGIN=http://localhost:3000,https://stryde-web.vercel.app

# Shared-secret gate for write endpoints (e.g. /api/ipfs/*). Must match
# EXPO_PUBLIC_API_KEY in apps/mobile/.env. Leave unset to disable in local dev.
API_KEY=

# Relayer wallet for API-initiated writes (e.g. mirroring a World ID
# verification onto ProfileRegistry). Must be a funded Sepolia account.
RELAYER_PRIVATE_KEY=
# Optional: refuse relayed writes while the network fee is above this many gwei (unset = no cap)
RELAYER_MAX_FEE_GWEI=

# World ID Selfie Check
WORLD_RP_SIGNING_KEY=
WORLD_APP_ID=
WORLD_RP_ID=
WORLD_ENVIRONMENT=sandbox
WORLD_SKIP_REMOTE_VERIFY=false
# Credentials that earn an Athlete Pass: selfie, proof_of_human, or both (comma-separated; default both).
# World App in production hangs on "selfie or proof_of_human" while Selfie Check isn't enabled for the app:
# set proof_of_human there until it is.
WORLD_PASS_CREDENTIALS=
WORLD_DEVELOPER_API_KEY=

# Stryde Coach on 0G Private Computer (router API key from https://pc.0g.ai). Unset = /coach answers 503.
ZEROG_API_KEY=
ZEROG_BASE_URL=https://router-api.0g.ai/v1
# Optional model lists, tried in order (a model whose providers are down sits out for 60 s).
# `id@standard` pins a model to no TEE floor. Unset chat = 0gm-1.0, then glm-5.3;
# unset image = seedream if listed, z-image-turbo (async), then minimax-image-01 (not TEE).
# Example: ZEROG_CHAT_MODEL=0gm-1.0-35b-a3b,glm-5.3
ZEROG_CHAT_MODEL=
ZEROG_IMAGE_MODEL=
ZEROG_STT_MODEL=
# Provider floor sent to the router: verified (default), private or standard. ZEROG_VERIFY_TEE=false skips attestation.
ZEROG_TRUST_MODE=
# Optional per-wallet daily allowances (defaults: 5 plans, 3 posters, 6 debriefs, 8 reviews).
ZEROG_DAILY_PLANS=
ZEROG_DAILY_POSTERS=
ZEROG_DAILY_DEBRIEFS=
ZEROG_DAILY_REVIEWS=

# Arkiv (Tiramisu testnet). Server-only: the access key goes in an X-API-KEY header, never in the app bundle.
ARKIV_ACCESS_KEY=
# Dev-only signer for Arkiv writes; fund with test GLM from https://hub.arkiv.network/faucet
ARKIV_PRIVATE_KEY=

# Most distance one wallet can be paid STRD for per UTC day (default 200000 = 200 km).
STRD_DAILY_REWARD_METERS=

# Where Athlete Passes are kept between restarts. Needs a persistent disk and a single instance;
# empty on a serverless host means they are lost on every restart.
WORLD_PRESENCE_FILE=
