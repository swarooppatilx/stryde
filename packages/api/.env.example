# API Configuration
# Base Sepolia
CHAIN_ID=84532
RPC_URL=https://sepolia.base.org

# IPFS Pinning (Pinata)
PINATA_API_KEY=
PINATA_SECRET_KEY=

# Push Notifications (Expo)
EXPO_ACCESS_TOKEN=

# The Graph
SUBGRAPH_URL=https://api.studio.thegraph.com/query/stryde/stryde-base-sepolia/version/latest

# Frontend
# Comma-separated list of allowed origins for CORS.
CORS_ORIGIN=http://localhost:3000

# Shared-secret gate for write endpoints (e.g. /api/ipfs/*). Must match
# EXPO_PUBLIC_API_KEY in apps/mobile/.env. Leave unset to disable in local dev.
API_KEY=

# Relay (role-gated on-chain operations)
RELAYER_PRIVATE_KEY=
RELAYER_CHAIN_ID=11155111
RELAYER_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
