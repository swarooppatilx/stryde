{
  "name": "@repo/api",
  "version": "0.0.0",
  "private": true,
  "packageManager": "yarn@4.18.0",
  "type": "module",
  "scripts": {
    "dev": "node --env-file=.env --env-file-if-exists=.env.local --import tsx src/dev.ts",
    "dev:prod": "node --env-file=.env.prod --env-file-if-exists=.env.local --import tsx src/dev.ts",
    "dev:production": "node --env-file-if-exists=.env.production --env-file-if-exists=.env.local --import tsx src/dev.ts",
    "build": "tsc",
    "lint": "biome check .",
    "test": "vitest run",
    "check-types": "tsc --noEmit && tsc -p tsconfig.test.json",
    "test:anvil": "vitest run --config vitest.anvil.config.ts"
  },
  "dependencies": {
    "@arkiv-network/sdk": "1.0.1",
    "@hono/node-server": "^1.14.1",
    "@types/node": "catalog:",
    "@worldcoin/idkit-core": "4.6.0",
    "@worldcoin/idkit-server": "^1.1.1",
    "expo-server-sdk": "^7.2.0",
    "hono": "^4.13.11",
    "jose": "6.2.15",
    "viem": "catalog:"
  },
  "devDependencies": {
    "@repo/typescript-config": "*",
    "tsx": "^4.19.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
