{
  "name": "@repo/shared",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "react-native": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./types": "./src/types.ts",
    "./constants": "./src/constants.ts",
    "./contracts": "./src/contracts.ts"
  },
  "scripts": {
    "lint": "biome check .",
    "test": "vitest run",
    "check-types": "tsc --noEmit",
    "generate:abis": "node scripts/generate-abis.mjs",
    "check:abis": "node scripts/generate-abis.mjs --check",
    "demo:preflight": "node --import tsx scripts/demo-preflight.mjs",
    "demo:seed": "node --import tsx scripts/seed-demo.mjs",
    "deploy:sync": "node scripts/sync-deployment.mjs",
    "test:anvil": "vitest run --config vitest.anvil.config.ts"
  },
  "dependencies": {
    "viem": "catalog:"
  },
  "devDependencies": {
    "@repo/typescript-config": "*",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
