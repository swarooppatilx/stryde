{
  "name": "@repo/contracts",
  "version": "0.0.0",
  "private": true,
  "main": "./src/index.ts",
  "react-native": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./src/abis/*.json": "./src/abis/*.json"
  },
  "scripts": {
    "build": "forge build",
    "test": "forge test -vvv",
    "lint": "forge fmt --check",
    "fmt": "forge fmt",
    "sizes": "forge build --sizes",
    "generate": "./scripts/generate-all.sh",
    "generate:abi": "./scripts/generate-all.sh",
    "lint:sol": "solhint 'src/**/*.sol' 'test/**/*.sol' 'script/**/*.sol'",
    "snapshot": "forge snapshot",
    "snapshot:check": "forge snapshot --check",
    "coverage": "forge coverage",
    "coverage:report": "forge coverage --report lcov",
    "deploy:local": "./scripts/deploy-local.sh",
    "deploy:all": "./scripts/deploy-all.sh",
    "deploy:ci": "./scripts/deploy-ci.sh"
  },
  "devDependencies": {
    "solhint": "5.0.0"
  }
}
