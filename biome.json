{
  "$schema": "https://biomejs.dev/schemas/2.5.12/schema.json",
  "files": {
    "includes": [
      "**",
      "!**/node_modules",
      "!**/.next",
      "!**/.turbo",
      "!**/dist",
      "!**/build",
      "!**/target",
      "!**/coverage",
      "!**/.expo",
      "!**/android",
      "!**/ios",
      "!**/*.lock",
      "!**/public/**/*.svg",
      "!packages/contracts/lib",
      "!packages/contracts/out",
      "!packages/contracts/broadcast",
      "!**/cache",
      "!**/next-env.d.ts",
      "!packages/subgraph/src",
      "!packages/subgraph/generated",
      "!packages/shared/src/abis.ts",
      "!.agents",
      "!agent",
      "!.claude",
      "!.codex"
    ]
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "correctness": {
        "noUnusedImports": "error",
        "noUnusedVariables": "error",
        "useExhaustiveDependencies": "warn"
      },
      "style": {
        "noNonNullAssertion": "error",
        "useImportType": "warn",
        "noNestedTernary": "error",
        "noParameterAssign": "error",
        "noUselessElse": "error",
        "useCollapsedElseIf": "error",
        "noNegationElse": "error",
        "useConst": "error"
      },
      "suspicious": {
        "noExplicitAny": "error",
        "noConsole": {
          "level": "error",
          "options": {
            "allow": ["warn", "error", "info"]
          }
        },
        "noImportCycles": "warn"
      },
      "a11y": {
        "useAltText": "warn",
        "useButtonType": "warn",
        "useValidAriaRole": "error"
      },
      "complexity": {
        "noExcessiveCognitiveComplexity": {
          "level": "error",
          "options": {
            "maxAllowedComplexity": 30
          }
        },
        "noUselessTernary": "error",
        "noExtraBooleanCast": "error"
      },
      "nursery": {
        "noFloatingPromises": "error"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always",
      "trailingCommas": "es5"
    }
  },
  "json": {
    "formatter": {
      "trailingCommas": "none"
    }
  },
  "overrides": [
    {
      "includes": [
        "**/scripts/**",
        "**/*.mjs",
        "packages/api/src/dev.ts",
        "**/__tests__/**",
        "**/*.test.ts"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off"
          }
        }
      }
    }
  ]
}
