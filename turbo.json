{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**", "out/**", "build/**", "dist/**"]
    },
    "@repo/api#build": {
      "dependsOn": ["^build"],
      "env": [
        "NODE_ENV",
        "CORS_ORIGIN",
        "API_KEY",
        "PINATA_API_KEY",
        "PINATA_SECRET_KEY",
        "RELAYER_CHAIN_ID",
        "RELAYER_RPC_URL"
      ],
      "outputs": ["dist/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "biome:check": {
      "cache": true,
      "inputs": ["$TURBO_DEFAULT$", "*.json"]
    },
    "test": {
      "dependsOn": ["^build"],
      "cache": true
    }
  }
}
