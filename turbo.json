{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "globalDependencies": ["biome.json", "**/tsconfig.json", "yarn.lock"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "env": ["NEXT_PUBLIC_*"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**", "out/**", "build/**", "dist/**"]
    },
    "@repo/api#build": {
      "dependsOn": ["^build"],
      "env": ["NODE_ENV", "CORS_ORIGIN"],
      "outputs": ["dist/**"]
    },
    "@repo/contracts#build": {
      "dependsOn": ["^build"],
      "outputs": ["out/**", "cache/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": ["^build"],
      "cache": true
    }
  }
}
